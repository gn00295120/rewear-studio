# Export these in your shell. This file is documentation; it is not loaded automatically.
# Keep MODEL_API_KEY private. It also supports ~/.config/meta/model_api_key.
MODEL_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=muse-glimmer:30b
# Optional absolute directory for database and media:
# REWEAR_DATA_DIR=/path/to/private/rewear-data
# Website mode must be explicitly enabled with rewear --hosted.
# REWEAR_PUBLIC_ORIGIN=https://wardrobe.example.com
# See docs/HOSTED_OPERATIONS.md and deploy/env.example for deployment.
# Optional Google original-photo index; disabled unless explicitly selected.
# Enabling it sends original garment crops to Google during shopping discovery.
REWEAR_IMAGE_SEARCH=disabled
# Set REWEAR_IMAGE_SEARCH=google_vision and choose one authentication method:
# REWEAR_VISION_API_KEY=  # Provide through your private environment/secret store.
# OR: install the image-search extra, use existing ADC, and explicitly select
# a project authorized for Vision API and its billing/quota:
# REWEAR_VISION_PROJECT=your-authorized-project-id
