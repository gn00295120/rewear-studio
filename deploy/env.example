# Example only. Supply the actual values via a private file or secret store.
# docker compose --env-file /private/path/rewear.env -f deploy/compose.yaml ...
REWEAR_DOMAIN=wardrobe.example.com
MODEL_API_KEY=
REWEAR_IMAGE_SEARCH=disabled
REWEAR_VISION_API_KEY=
REWEAR_MAX_ACCOUNTS=1000
REWEAR_MAX_ACTIVE_TENANTS=16
REWEAR_MAX_JOBS_PER_TENANT=200
REWEAR_MAX_MEDIA_MIB_PER_TENANT=2048
# Judge/demo site: `managed` closes sign-up, password change and self-recovery; create logins with
# docker compose ... exec app rewear account create --hosted-data-dir /var/lib/rewear/data --username judge
REWEAR_ACCOUNTS=open
# Per-account cap on estimated model spend over a rolling 24 hours, in US dollars (empty = no cap).
REWEAR_DAILY_SPEND_LIMIT_USD=
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=muse-glimmer:30b
